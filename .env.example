# Telegram Bot Configuration
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your-bot-token-here

# Admin Telegram User ID
# Find your ID by messaging @userinfobot on Telegram
ADMIN_TELEGRAM_ID=123456789

# Gemini API Keys (one per service for isolation)
# Get API keys from https://makersuite.google.com/app/apikey
GEMINI_API_KEY_DISPATCHER=your-gemini-key-for-dispatcher
GEMINI_API_KEY_FINANCE=your-gemini-key-for-finance
GEMINI_API_KEY_VISA=your-gemini-key-for-visa

# Inter-Service Authentication Keys
# Generate with: openssl rand -hex 32
SERVICE_KEY_FINANCE=your-random-64-char-hex-string-for-finance
SERVICE_KEY_VISA=your-random-64-char-hex-string-for-visa

# Usage Quotas
# Maximum number of requests per day
DAILY_REQUEST_LIMIT=50

# Maximum number of tokens per day (Gemini API)
DAILY_TOKEN_LIMIT=1000000

# Logging Configuration
# Levels: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Optional: Override log level per service
# LOG_LEVEL_DISPATCHER=info
# LOG_LEVEL_FINANCE=info
# LOG_LEVEL_VISA=info

# Container Ports (for local development)
DISPATCHER_PORT=3000
FINANCE_AGENT_PORT=3001
VISA_AGENT_PORT=3002
